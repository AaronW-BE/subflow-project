# Copy to android/keystore.properties and fill in before building a release bundle.
# NEVER commit the real file or the .jks itself.
#
#   keytool -genkeypair -v -keystore subflow-release.jks -alias subflow \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the `android/` directory.
storeFile=subflow-release.jks
storePassword=CHANGE_ME
keyAlias=subflow
keyPassword=CHANGE_ME
