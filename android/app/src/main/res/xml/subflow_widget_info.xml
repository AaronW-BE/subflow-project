<?xml version="1.0" encoding="utf-8"?>
<!--
    Placed three cells by two, which fits the total and the first few renewals;
    the list scrolls for the rest and grows if the widget is dragged taller.
    It can still be shrunk to one cell tall, where only the total fits.
    SizeMode.Responsive in SubFlowWidget picks between the two.

    Placing it one cell tall by default is what made the widget look like it
    could only show a single subscription.

    updatePeriodMillis is six hours because the days-left figures go stale on
    their own, with nothing running to notice. Every other change - an edit, a
    pause, a new currency - redraws immediately through refreshSubFlowWidget.

    previewLayout is what the launcher's widget picker draws (API 31+): a
    static copy of the widget with sample data, in the phone's language. Before
    it, the picker showed only the app icon. Launchers older than 31 ignore
    previewLayout and fall back to previewImage, which stays the icon.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="21600000"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_preview"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
