<?xml version="1.0" encoding="utf-8"?>
<!--
    What the launcher's widget picker shows for SubFlow (android:previewLayout,
    API 31+). Before this the picker showed the app icon, which says nothing
    about what the widget does.

    It is a static copy of SubFlowWidget's tall layout - the label, the total,
    and a few renewal rows - with sample data, because a preview is rendered by
    the launcher before any widget exists and cannot read the database. Glance
    1.1.1 has no generated previews, so this is plain RemoteViews-safe XML:
    LinearLayout and TextView only.

    Keep the sizes and colours in step with SubFlowWidget.kt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/total_monthly_spend"
        android:textColor="@color/widget_ink_dim"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_total"
        android:textColor="@color/widget_ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Row 1: due soon, so its days-left line takes the accent colour. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_name_1"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_when_1"
                android:textColor="@color/widget_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/widget_preview_price_1"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 2: a running trial, priced "Free" in the accent colour. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_name_2"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_when_2"
                android:textColor="@color/widget_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/trial_free_amount"
            android:textColor="@color/widget_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 3: further out, so its days-left line is dimmed. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_name_3"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_when_3"
                android:textColor="@color/widget_ink_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/widget_preview_price_3"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
